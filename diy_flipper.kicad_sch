			)
			(justify left top)
		)
		(uuid "7bda477d-81a7-4c8a-a892-8dc3447aa164")
	)
	(text "Charge current = 1000 V / R7 = 500 mA with 2k. Use a protected Li-Po cell of 1000 mAh or more and check its plug polarity.\nPower path: on USB the system runs from VBUS through D1 and Q1 isolates the battery; on battery Q1 conducts.\nVBAT_SENSE = VBAT / 2 (ADC1 on GPIO5).  CHG_STAT is low while charging."
		(exclude_from_sim no)
		(at 185.42 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "94ed993b-3b0b-4a8f-9701-d600ac208f35")
	)
	(text "MCU  -  ESP32-S3-WROOM-1 (Wi-Fi, Bluetooth LE, native USB)"
