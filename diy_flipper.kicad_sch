	(text "SUB-GHz  -  CC1101 MODULE"
		(exclude_from_sim no)
		(at 247.54 167.54 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "1c5c841d-c28e-4b8e-88a3-cc3a04c2c35e")
	)
	(text "DIY Flipper-style multitool - custom-firmware design (NOT pin compatible with the official Flipper Zero firmware).\n\nBuses:  SPI (SCK IO12, MOSI IO11, MISO IO13) is shared by OLED, microSD, CC1101.  I2C (SDA IO1, SCL IO2) is shared by PN532, PCF8574.\nUSB:    native USB on IO19/IO20 - firmware upload, serial console and HID keyboard (BadUSB) with no extra chip.\nStorage: 16 MB flash in the module for firmware, microSD for apps and data.\n\nConnections inside each block are drawn as wires; net labels are used only for signals that go to the MCU or to another block.\nBefore PCB layout: check every pin number against the datasheet of the exact part / module you bought.\nMotor, iButton contacts and coil use 2-pin header pads as placeholder footprints.\nKeep the ESP32 antenna at the board edge with no copper under it, and keep the CC1101 and PN532 antennas apart."
		(exclude_from_sim no)
		(at 490.22 317.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1f92e801-ad9a-4380-8896-4ec1e30734a5")
	)
	(text "GPIO EXPANSION HEADER"
		(exclude_from_sim no)
		(at 514.54 17.54 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "342cc2cb-fd1f-4905-aaac-e581b187ca85")
	)
	(text "Write 1 to every port bit, then read: a pressed button reads 0.\nEXP_INT pulses low on any change (buttons, charger, SD detect)."
